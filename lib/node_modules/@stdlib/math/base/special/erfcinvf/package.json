  "__stdlib__": {
    "scaffold": {
      "$schema": "math/base@v1.0",
      "base_alias": "erfcinv",
      "alias": "erfcinvf",
      "pkg_desc": "evaluate the inverse complementary error function for a single-precision floating-point number",
      "desc": "evaluates the inverse complementary error function for a single-precision floating-point number",
      "short_desc": "inverse complementary error function",
      "parameters": [
        {
          "name": "x",
          "desc": "input value",
          "type": {
