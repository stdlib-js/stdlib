{
  "name": "@stdlib/math/base/special/silu",
  "version": "0.0.0",
  "description": "Evaluate the Sigmoid Linear Unit (SiLU).",
  "license": "Apache-2.0",
  "author": {
    "name": "The Stdlib Authors",
    "url": "https://github.com/stdlib-js/stdlib/graphs/contributors"
  },
  "contributors": [
    {
      "name": "The Stdlib Authors",
      "url": "https://github.com/stdlib-js/stdlib/graphs/contributors"
    }
  ],
  "main": "./lib",
  "gypfile": true,
  "directories": {
    "benchmark": "./benchmark",
    "doc": "./docs",
    "example": "./examples",
    "include": "./include",
    "lib": "./lib",
    "src": "./src",
    "test": "./test"
  },
  "types": "./docs/types",
  "scripts": {},
  "homepage": "https://github.com/stdlib-js/stdlib",
  "repository": {
    "type": "git",
    "url": "git://github.com/stdlib-js/stdlib.git"
  },
  "bugs": {
    "url": "https://github.com/stdlib-js/stdlib/issues"
  },
  "dependencies": {},
  "devDependencies": {},
  "engines": {
    "node": ">=0.10.0",
    "npm": ">2.7.0"
  },
  "os": [
    "aix",
    "darwin",
    "freebsd",
    "linux",
    "macos",
    "openbsd",
    "sunos",
    "win32",
    "windows"
  ],
  "keywords": [
    "stdlib",
    "stdmath",
    "mathematics",
    "math",
    "silu",
    "swish",
    "activation",
    "sigmoid",
    "sigmoid linear unit",
    "neural",
    "deep learning"
  ],
  "__stdlib__": {
    "scaffold": {
      "$schema": "math/base@v1.0",
      "base_alias": "silu",
      "alias": "silu",
      "pkg_desc": "evaluate the Sigmoid Linear Unit (SiLU) for a double-precision floating-point number",
      "desc": "evaluates the Sigmoid Linear Unit (SiLU) for a double-precision floating-point number",
      "short_desc": "sigmoid linear unit",
      "parameters": [
        {
          "name": "x",
          "desc": "input value",
          "type": {
            "javascript": "number",
            "jsdoc": "number",
            "c": "double",
            "dtype": "float64"
          },
          "domain": [
            {
              "min": "-infinity",
              "max": "infinity"
            }
          ],
          "rand": {
            "prng": "random/base/uniform",
            "parameters": [
              -5,
              5
            ]
          },
          "example_values": [
            3.28,
            -3.04,
            -0.06,
            -4.23,
            4.84,
            2.62,
            -4.89,
            -1.56,
            4.25,
            0.33,
            -0.49,
            0.48,
            3.91,
            -4.82,
            -3.7,
            4.14,
            -1.61,
            0.32,
            4.51,
            -1.55
          ]
        }
      ],
      "output_policy": "real_floating_point_and_generic",
      "returns": {
        "desc": "evaluated SiLU",
        "type": {
          "javascript": "number",
          "jsdoc": "number",
          "c": "double",
          "dtype": "float64"
        }
      },
      "keywords": [
        "silu",
        "swish",
        "activation",
        "sigmoid",
        "neural",
        "deep learning",
        "sigmoid linear unit"
      ],
      "extra_keywords": []
    }
  }
}
