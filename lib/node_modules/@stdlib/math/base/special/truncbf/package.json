{
  "name": "@stdlib/math/base/special/truncbf",
  "version": "0.0.0",
  "description": "Round a single-precision floating-point number toward zero to n digits in base b.",
  "license": "Apache-2.0",
  "author": {
    "name": "The Stdlib Authors",
    "url": "https://github.com/stdlib-js/stdlib/graphs/contributors"
  },
  "contributors": [
    {
      "name": "The Stdlib Authors",
      "url": "https://github.com/stdlib-js/stdlib/graphs/contributors"
    }
  ],
  "main": "./lib",
  "gypfile": true,
  "directories": {
    "benchmark": "./benchmark",
    "doc": "./docs",
    "example": "./examples",
    "include": "./include",
    "lib": "./lib",
    "src": "./src",
    "test": "./test"
  },
  "types": "./docs/types",
  "scripts": {},
  "homepage": "https://github.com/stdlib-js/stdlib",
  "repository": {
    "type": "git",
    "url": "git://github.com/stdlib-js/stdlib.git"
  },
  "bugs": {
    "url": "https://github.com/stdlib-js/stdlib/issues"
  },
  "dependencies": {
    "@stdlib/math/base/assert/is-infinitef": "^0.2.2",
    "@stdlib/math/base/assert/is-nanf": "^0.2.2",
    "@stdlib/math/base/napi/ternary": "^0.2.2",
    "@stdlib/math/base/special/powf": "^0.2.2",
    "@stdlib/math/base/special/truncf": "^0.2.2",
    "@stdlib/number/float64/base/to-float32": "^0.2.2",
    "@stdlib/utils/library-manifest": "^0.2.2"
  },
  "devDependencies": {
    "@stdlib/constants/float32/eps": "^0.2.2",
    "@stdlib/constants/float32/ninf": "^0.2.2",
    "@stdlib/constants/float32/pinf": "^0.2.2",
    "@stdlib/math/base/assert/is-negative-zerof": "^0.2.2",
    "@stdlib/math/base/assert/is-positive-zerof": "^0.2.2",
    "@stdlib/math/base/special/abs": "^0.2.2",
    "istanbul": "^0.4.1",
    "tap-min": "git+https://github.com/Planeshifter/tap-min.git",
    "tape": "git+https://github.com/kgryte/tape.git#fix/globby"
  },
  "engines": {
    "node": ">=0.10.0",
    "npm": ">2.7.0"
  },
  "os": [
    "aix",
    "darwin",
    "freebsd",
    "linux",
    "macos",
    "openbsd",
    "sunos",
    "win32",
    "windows"
  ],
  "keywords": [
    "stdlib",
    "stdmath",
    "mathematics",
    "math",
    "special",
    "functions",
    "function",
    "base",
    "number",
    "float",
    "float32",
    "single",
    "precision",
    "floating-point",
    "truncate",
    "trunc",
    "round",
    "digits",
    "rounding"
  ],
  "__stdlib__": {
    "scaffold": {
      "$schema": "math/base@v1.0",
      "base_alias": "truncb",
      "alias": "truncbf",
      "pkg_desc": "round a single-precision floating-point number toward zero to n digits in base b",
      "desc": "rounds a single-precision floating-point number toward zero to `n` digits in base `b`",
      "short_desc": "round a single-precision floating-point number toward zero to n digits in base b",
      "parameters": [
        {
          "name": "x",
          "desc": "input value",
          "type": {
            "javascript": "number",
            "jsdoc": "number",
            "c": "float",
            "dtype": "float32"
          },
          "domain": [
            {
              "min": "-infinity",
              "max": "infinity"
            }
          ],
          "rand": {
            "prng": "random/base/uniform",
            "parameters": [
              -100,
              100
            ]
          },
          "example_values": [
            3.14159,
            -3.14159,
            15,
            -15,
            123.456,
            -123.456,
            7.875,
            -7.875,
            255.99,
            -255.99,
            0.123456,
            -0.123456,
            1.23456789,
            -1.23456789,
            9.999,
            -9.999,
            20,
            -20,
            5.6789,
            -5.6789
          ]
        },
        {
          "name": "n",
          "desc": "number of digits",
          "type": {
            "javascript": "integer",
            "jsdoc": "integer",
            "c": "int32_t",
            "dtype": "int32"
          },
          "domain": [
            {
              "min": "-infinity",
              "max": "infinity"
            }
          ],
          "rand": {
            "prng": "random/base/discrete-uniform",
            "parameters": [
              -5,
              5
            ]
          },
          "example_values": [
            2,
            3,
            -1,
            0,
            1,
            4,
            -2,
            5,
            -3,
            2,
            3,
            1,
            0,
            2,
            1,
            3,
            -2,
            2,
            1,
            2
          ]
        },
        {
          "name": "b",
          "desc": "base",
          "type": {
            "javascript": "integer",
            "jsdoc": "integer",
            "c": "int32_t",
            "dtype": "int32"
          },
          "domain": [
            {
              "min": "0",
              "max": "infinity"
            }
          ],
          "rand": {
            "prng": "random/base/discrete-uniform",
            "parameters": [
              2,
              16
            ]
          },
          "example_values": [
            10,
            10,
            10,
            10,
            10,
            10,
            2,
            2,
            16,
            16,
            8,
            8,
            10,
            10,
            10,
            10,
            2,
            10,
            10,
            10
          ]
        }
      ],
      "returns": [
        {
          "type": {
            "javascript": "number",
            "jsdoc": "number",
            "c": "float",
            "dtype": "float32"
          }
        }
      ],
      "tests": {
        "hermitian": false,
        "symmetric": false
      }
    }
  }
}
