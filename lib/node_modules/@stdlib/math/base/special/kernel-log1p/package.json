  "__stdlib__": {
    "scaffold": {
      "$schema": "math/base@v1.0",
      "base_alias": "kernel-log1p",
      "alias": "kernel-log1p",
      "pkg_desc": "evaluate a correction term for double-precision base-2 and base-10 logarithms when 1+f is in [√2/2, √2]",
      "desc": "evaluates a correction term for double-precision base-2 and base-10 logarithms when 1+f is in [√2/2, √2]",
      "short_desc": "",
      "parameters": [
        {
          "name": "x",
          "desc": "input value",
          "type": {
            "javascript": "number",
            "jsdoc": "number",
            "c": "double",
            "dtype": "float64"
          },
          "domain": [
            {
              "min": "-infinity",
              "max": "infinity"
            }
          ],
          "rand": {
            "prng": "random/base/uniform",
            "parameters": [
              -2,
              1
            ]
          },
          "example_values": [
            -0.2929,
            -0.25,
            -0.2,
            -0.15,
            -0.1,
            -0.05,
            0,
            0.05,
            0.1,
            0.15,
            0.2,
            0.25,
            0.3,
            0.35,
            0.4,
            0.4142
          ]
        }
      ],
      "output_policy": "real_floating_point_and_generic",
      "returns": {
        "desc": "function value",
        "type": {
          "javascript": "number",
          "jsdoc": "number",
          "c": "double",
          "dtype": "float64"
        }
      },
      "keywords": [
        "log",
        "kernel",
        "logarithm"
      ],
      "extra_keywords": []
    }
  }
