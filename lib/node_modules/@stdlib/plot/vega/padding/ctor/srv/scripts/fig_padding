#!/usr/bin/env node
'use strict';

/* eslint-disable max-lines, stdlib/no-unnecessary-nested-functions */

// MODULES //

var resolve = require( 'path' ).resolve;
var join = require( 'path' ).join;
var logger = require( 'debug' );
var readdir = require( '@stdlib/fs/read-dir' );
var unlink = require( '@stdlib/fs/unlink' );
var exists = require( '@stdlib/fs/exists' );
var renderFig = require( '@stdlib/plot/vega/base/spec2svg-file' );


// VARIABLES //

var debug = logger( 'vega:padding:figures' );

var IMG_DIR = resolve( __dirname, '..', '..', 'docs', 'img' );
var SCHEMA = 'https://vega.github.io/schema/vega/v6.json';
var OUTER_MARGIN = 15;
var OUTER_WIDTH = 600;
var OUTER_HEIGHT = 260;
var DEFAULT_PADDING = 80;
var LABEL_FONT_SIZE = 13;
var LABEL_FONT_WEIGHT = 'bold';
var LABEL_FILL = '#555';

/**
* Figure configuration array.
*/
var FIGURES = [
	{
		'name': 'figure_padding',
		'padding': {
			'left': DEFAULT_PADDING,
			'right': DEFAULT_PADDING,
			'top': DEFAULT_PADDING,
			'bottom': DEFAULT_PADDING
		},
		'marks': [
			createTextLabel( 40, 130, 'left: 80px' ),
			createTextLabel( 560, 130, 'right: 80px' ),
			createTextLabel( 300, 40, 'top: 80px' ),
			createTextLabel( 300, 220, 'bottom: 80px' )
		]
	},

	// top:
	{
		'name': 'figure_padding_top_0',
		'padding': {
			'left': DEFAULT_PADDING,
			'right': DEFAULT_PADDING,
			'top': 0,
			'bottom': DEFAULT_PADDING
		}
	},
	{
		'name': 'figure_padding_top_100',
		'padding': {
			'left': DEFAULT_PADDING,
			'right': DEFAULT_PADDING,
			'top': 100,
			'bottom': DEFAULT_PADDING
		}
	},

	// bottom:
	{
		'name': 'figure_padding_bottom_0',
		'padding': {
			'left': DEFAULT_PADDING,
			'right': DEFAULT_PADDING,
			'top': DEFAULT_PADDING,
			'bottom': 0
		}
	},
	{
		'name': 'figure_padding_bottom_100',
		'padding': {
			'left': DEFAULT_PADDING,
			'right': DEFAULT_PADDING,
			'top': DEFAULT_PADDING,
			'bottom': 100
		}
	},

	// left:
	{
		'name': 'figure_padding_left_0',
		'padding': {
			'left': 0,
			'right': DEFAULT_PADDING,
			'top': DEFAULT_PADDING,
			'bottom': DEFAULT_PADDING
		}
	},
	{
		'name': 'figure_padding_left_130',
		'padding': {
			'left': 130,
			'right': DEFAULT_PADDING,
			'top': DEFAULT_PADDING,
			'bottom': DEFAULT_PADDING
		}
	},

	// right:
	{
		'name': 'figure_padding_right_0',
		'padding': {
			'left': DEFAULT_PADDING,
			'right': 0,
			'top': DEFAULT_PADDING,
			'bottom': DEFAULT_PADDING
		}
	},
	{
		'name': 'figure_padding_right_130',
		'padding': {
			'left': DEFAULT_PADDING,
			'right': 130,
			'top': DEFAULT_PADDING,
			'bottom': DEFAULT_PADDING
		}
	}
];


// FUNCTIONS //

/**
* Creates a Vega text label mark definition.
*
* @private
* @param {number} x - x-coordinate
* @param {number} y - y-coordinate
* @param {string} text - label text
* @returns {Object} Vega mark definition
*/
function createTextLabel( x, y, text ) {
	return {
		'type': 'text',
		'encode': {
			'enter': {
				'x': {
					'value': x
				},
				'y': {
					'value': y
				},
				'align': {
					'value': 'center'
				},
				'baseline': {
					'value': 'middle'
				},
				'text': {
					'value': text
				},
				'fontSize': {
					'value': LABEL_FONT_SIZE
				},
				'fontWeight': {
					'value': LABEL_FONT_WEIGHT
				},
				'fill': {
					'value': LABEL_FILL
				}
			}
		}
	};
}

/**
* Creates a Vega rectangle mark for the outer dotted boundary.
*
* @private
* @param {number} width - outer width
* @param {number} height - outer height
* @returns {Object} Vega mark definition
*/
function createOuterRect( width, height ) {
	return {
		'type': 'rect',
		'encode': {
			'enter': {
				'x': {
					'value': 0
				},
				'y': {
					'value': 0
				},
				'width': {
					'value': width
				},
				'height': {
					'value': height
				},
				'stroke': {
					'value': '#aaa'
				},
				'strokeWidth': {
					'value': 1.5
				},
				'strokeDash': {
					'value': [ 4, 4 ]
				}
			}
		}
	};
}

/**
* Creates a Vega rectangle mark for the inner chart area.
*
* @private
* @param {number} x - x-coordinate
* @param {number} y - y-coordinate
* @param {number} width - width
* @param {number} height - height
* @returns {Object} Vega mark definition
*/
function createInnerRect( x, y, width, height ) {
	return {
		'type': 'rect',
		'encode': {
			'enter': {
				'x': {
					'value': x
				},
				'y': {
					'value': y
				},
				'width': {
					'value': width
				},
				'height': {
					'value': height
				},
				'fill': {
					'value': '#f5f5f5'
				},
				'stroke': {
					'value': '#666'
				},
				'strokeWidth': {
					'value': 1
				}
			}
		}
	};
}

/**
* Creates a Vega specification from a figure configuration.
*
* @private
* @param {Object} config - figure configuration
* @param {Object} config.padding - padding configuration
* @param {Array} [config.marks] - additional marks
* @returns {Object} Vega specification
*/
function createSpec( config ) {
	var innerHeight;
	var innerWidth;
	var padding;
	var marks;
	var spec;
	var x;
	var y;

	padding = config.padding;

	// Compute inner chart area dimensions based on actual padding values:
	x = padding.left;
	y = padding.top;
	innerWidth = OUTER_WIDTH - padding.left - padding.right;
	innerHeight = OUTER_HEIGHT - padding.top - padding.bottom;

	marks = [
		createOuterRect( OUTER_WIDTH, OUTER_HEIGHT ),
		createInnerRect( x, y, innerWidth, innerHeight )
	];
	if ( config.marks ) {
		marks = marks.concat( config.marks );
	}
	spec = {
		'$schema': SCHEMA,
		'width': OUTER_WIDTH,
		'height': OUTER_HEIGHT,
		'padding': OUTER_MARGIN,
		'background': '#ffffff',
		'marks': marks
	};
	return spec;
}

/**
* Generates all figure SVGs sequentially.
*
* @private
* @param {Array} figures - figure configuration array
* @param {Callback} clbk - callback to invoke upon completion
* @returns {void}
*/
function generateAll( figures, clbk ) {
	var idx = 0;

	next();

	/**
	* Processes the next figure in the queue.
	*
	* @private
	* @returns {void}
	*/
	function next() {
		var outputPath;
		var config;
		var spec;

		if ( idx >= figures.length ) {
			return clbk( null );
		}
		config = figures[ idx ];
		spec = createSpec( config );
		outputPath = join( IMG_DIR, config.name + '.svg' );

		debug( 'Rendering: %s', config.name );
		renderFig( outputPath, spec, onDone );
	}

	/**
	* Callback invoked upon completing a figure render.
	*
	* @private
	* @param {(Error|null)} error - error object
	* @returns {void}
	*/
	function onDone( error ) {
		if ( error ) {
			return clbk( error );
		}
		debug( '  -> %s', join( IMG_DIR, figures[ idx ].name + '.svg' ) );
		idx += 1;
		next();
	}
}

/**
* Removes stale SVG files from a list of directory entries.
*
* @private
* @param {Array} files - directory entries
* @param {Callback} clbk - callback to invoke upon completion
* @returns {void}
*/
function removeStaleFiles( files, clbk ) {
	var idx = 0;

	next();

	/**
	* Processes the next file in the queue.
	*
	* @private
	* @returns {void}
	*/
	function next() {
		var valid;
		var file;
		var j;

		while ( idx < files.length ) {
			file = files[ idx ];
			if ( file.indexOf( '.svg' ) === -1 ) {
				idx += 1;
				continue;
			}
			valid = false;
			for ( j = 0; j < FIGURES.length; j++ ) {
				if ( file === FIGURES[ j ].name + '.svg' ) {
					valid = true;
					break;
				}
			}
			if ( !valid ) {
				debug( 'Removing stale SVG: %s', file );
				unlink( join( IMG_DIR, file ), onRemove );
				return;
			}
			idx += 1;
		}
		return clbk( null );
	}

	/**
	* Callback invoked upon removing a file.
	*
	* @private
	* @param {(Error|null)} error - error object
	* @returns {void}
	*/
	function onRemove( error ) {
		if ( error ) {
			return clbk( error );
		}
		idx += 1;
		next();
	}
}


// MAIN //

/**
* Generates all padding documentation figures.
*
* @private
* @returns {void}
*/
function main() {
	exists( IMG_DIR, onExists );

	/**
	* Callback invoked upon checking directory existence.
	*
	* @private
	* @param {boolean} bool - boolean indicating whether the path exists
	* @returns {void}
	*/
	function onExists( bool ) {
		if ( !bool ) {
			return generateAll( FIGURES, onComplete );
		}
		readdir( IMG_DIR, onRead );
	}

	/**
	* Callback invoked upon reading directory contents.
	*
	* @private
	* @param {(Error|null)} error - error object
	* @param {Array} files - directory entries
	* @returns {void}
	*/
	function onRead( error, files ) {
		if ( error ) {
			return onComplete( error );
		}
		removeStaleFiles( files, onClean );
	}

	/**
	* Callback invoked upon completing stale file cleanup.
	*
	* @private
	* @param {(Error|null)} error - error object
	* @returns {void}
	*/
	function onClean( error ) {
		if ( error ) {
			return onComplete( error );
		}
		generateAll( FIGURES, onComplete );
	}

	/**
	* Callback invoked upon completing all figure generation.
	*
	* @private
	* @param {(Error|null)} error - error object
	* @returns {void}
	*/
	function onComplete( error ) {
		if ( error ) {
			console.error( 'Error generating figures: %s', error.message ); // eslint-disable-line no-console
			process.exitCode = 1;
			return;
		}
		console.log( 'Successfully generated %d padding figures.', FIGURES.length ); // eslint-disable-line no-console
	}
}

main();
