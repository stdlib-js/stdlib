#/
# To compile targets listed in this Makefile, use top-level project `make`
# commands rather than commands listed in this Makefile. The top-level project
# `make` commands will ensure that various environment variables and flags are
# appropriately set.
#/

# VARIABLES #

ifndef VERBOSE
	QUIET := @
else
	QUIET :=
endif

# Determine the OS ([1][1], [2][2]).
#
# [1]: https://en.wikipedia.org/wiki/Uname#Examples
# [2]: http://stackoverflow.com/a/27776822/2225624
OS ?= $(shell uname)
ifneq (, $(findstring MINGW,$(OS)))
	OS := WINNT
else
ifneq (, $(findstring MSYS,$(OS)))
	OS := WINNT
else
ifneq (, $(findstring CYGWIN,$(OS)))
	OS := WINNT
else
ifneq (, $(findstring Windows_NT,$(OS)))
	OS := WINNT
endif
endif
endif
endif

# Define the program used for compiling C/C++ source files to WebAssembly:
ifdef EMCC_COMPILER
	EMCC := $(EMCC_COMPILER)
else
	EMCC := emcc
endif

# Define the program used for compiling WebAssembly files to the WebAssembly text format:
ifdef WASM2WAT
	WASM_TO_WAT := $(WASM2WAT)
else
	WASM_TO_WAT := wasm2wat
endif

# Define the program used for compiling WebAssembly files to JavaScript:
ifdef WASM2JS
	WASM_TO_JS := $(WASM2JS)
else
	WASM_TO_JS := wasm2js
endif

# Define the path to the Node.js executable:
ifdef NODE
	NODEJS := $(NODE)
else
	NODEJS := node
endif

# Define the integer size:
ifdef CBLAS_INT
	INT_TYPE := $(CBLAS_INT)
else
	INT_TYPE := int32_t
endif

# Define the command-line options when compiling C files:
CFLAGS ?= \
	-std=c99 \
	-O3 \
	-flto \
	-Wall \
	-pedantic \
	-D CBLAS_INT=$(INT_TYPE)

# Define the command-line options when compiling C++ files.
#
# C++17 is required for Highway. The `-Wno-gnu-zero-variadic-macro-arguments`
# flag silences a benign warning emitted by `hwy/base.h` (the `##__VA_ARGS__`
# GNU extension is intentional and supported by all relevant compilers).
CXXFLAGS ?= \
	-std=c++17 \
	-O3 \
	-flto \
	-Wall \
	-pedantic \
	-Wno-gnu-zero-variadic-macro-arguments \
	-D CBLAS_INT=$(INT_TYPE)

# Define shared `emcc` flags that are valid both for compilation and linking
# (e.g. optimisation, exception handling, side-module configuration).
EMCC_COMMON_FLAGS := \
	-Oz \
	-fwasm-exceptions \
	-s SUPPORT_LONGJMP=1 \
	-s SIDE_MODULE=2

# Define flags that are only valid during compilation. None at the moment.
EMCC_COMPILE_FLAGS :=

# Define flags that are only valid during linking. These configure the
# WebAssembly output format and the exported function list.
EMCC_LINK_FLAGS := \
	-s WASM=1 \
	-s WASM_BIGINT=0 \
	-s EXPORTED_FUNCTIONS="$(shell cat exports.json | tr -d ' \t\n' | sed s/\"/\'/g)"

# When Highway is used, we want `emcc` to emit the WebAssembly fixed-width
# 128-bit SIMD instructions. Highway detects WASM SIMD128 support via the
# `__wasm_simd128__` predefined macro, which `emcc` only defines when
# `-msimd128` is passed. We only enable this flag when a Highway include path
# has been provided.
ifdef DEPS_HIGHWAY_INCLUDE
	EMCC_HIGHWAY_FLAGS := -msimd128
else
	EMCC_HIGHWAY_FLAGS :=
endif

# List of includes (e.g., `-I /foo/bar -I /beep/boop/include`):
INCLUDE ?=

# Path to a Highway installation include directory. When set, the include
# directory is added to the compiler command line and the `-msimd128` emcc
# flag is enabled so that Highway can emit WebAssembly fixed-width 128-bit
# SIMD instructions.
ifdef DEPS_HIGHWAY_INCLUDE
	INCLUDE += -I$(DEPS_HIGHWAY_INCLUDE)
endif

# List of source files:
SOURCE_FILES ?=

# Split source files by language so that we can apply the appropriate language
# standard when compiling. `emcc` rejects mixing `-std=c99` and `-std=c++17`
# in a single invocation, so we must invoke it once per language.
C_SOURCES := $(filter %.c,$(SOURCE_FILES))
CXX_SOURCES := $(filter %.cpp %.cc,$(SOURCE_FILES))

# Object files are written to a dedicated directory with a synthetic basename
# (`c0.o`, `c1.o`, ...) to avoid collisions when unrelated sources share the
# same basename (e.g. multiple `main.c` files in transitive dependencies).
OBJ_DIR := objs
C_OBJS := $(addprefix $(OBJ_DIR)/c,$(addsuffix .o,$(shell seq 1 $(words $(C_SOURCES)))))
CXX_OBJS := $(addprefix $(OBJ_DIR)/cxx,$(addsuffix .o,$(shell seq 1 $(words $(CXX_SOURCES)))))
ALL_OBJS := $(C_OBJS) $(CXX_OBJS)

# List of libraries (e.g., `-lopenblas -lpthread`):
LIBRARIES ?=

# List of library paths (e.g., `-L /foo/bar -L /beep/boop`):
LIBPATH ?=

# List of WebAssembly targets:
wasm_targets := main.wasm

# List of WebAssembly WAT targets:
wat_targets := main.wat

# List of WebAssembly JavaScript targets:
wasm_js_targets := main.wasm.js

# List of other JavaScript targets:
browser_js_targets := ./../lib/binary.browser.js


# RULES #

#/
# Compiles source files.
#
# @param {string} [EMCC_COMPILER] - EMCC compiler (e.g., `emcc`)
# @param {string} [CFLAGS] - C compiler options
# @param {string} [CXXFLAGS] - C++ compiler options
# @param {string} [WASM2WAT] - WebAssembly text format compiler (e.g., `wasm2wat`)
# @param {string} [WASM2JS] - WebAssembly JavaScript compiler (e.g., `wasm2js`)
# @param {string} [INCLUDE] - list of includes (e.g., `-I /foo/bar -I /beep/boop/include`)
# @param {string} [SOURCE_FILES] - list of source files
# @param {string} [LIBPATH] - list of library paths (e.g., `-L /foo/bar -L /beep/boop`)
# @param {string} [LIBRARIES] - list of libraries (e.g., `-lopenblas -lpthread`)
#
# @example
# make
#
# @example
# make all
#/
all: wasm

.PHONY: all

#/
# Compiles source files to WebAssembly.
#
# @param {string} [EMCC_COMPILER] - EMCC compiler (e.g., `emcc`)
# @param {string} [CFLAGS] - C compiler options
# @param {string} [CXXFLAGS] - C++ compiler options
# @param {string} [WASM2WAT] - WebAssembly text format compiler (e.g., `wasm2wat`)
# @param {string} [WASM2JS] - WebAssembly JavaScript compiler (e.g., `wasm2js`)
# @param {string} [INCLUDE] - list of includes (e.g., `-I /foo/bar -I /beep/boop/include`)
# @param {string} [SOURCE_FILES] - list of source files
# @param {string} [LIBPATH] - list of library paths (e.g., `-L /foo/bar -L /beep/boop`)
# @param {string} [LIBRARIES] - list of libraries (e.g., `-lopenblas -lpthread`)
#
# @example
# make wasm
#/
wasm: $(wasm_targets) $(wat_targets) $(browser_js_targets)

.PHONY: wasm

#/
# Compiles C/C++ source files to WebAssembly binaries.
#
# ## Notes
#
# -   `emcc` rejects mixing `-std=c99` and `-std=c++17` in a single invocation.
#     Because the upstream manifest can pull in C sources (e.g. via transitive
#     dependencies such as `@stdlib/blas/base/shared`) alongside the C++ SIMD
#     wrapper, we split the source list by extension and invoke `emcc` once
#     per language. Each invocation uses the appropriate language standard,
#     producing a `.o` per source. A final `emcc` invocation then links the
#     object files into the WebAssembly module.
# -   Link-time flags (`-s WASM=1`, `-s EXPORTED_FUNCTIONS=...`, etc.) are
#     only passed to the link invocation; passing them to the compile step
#     triggers `emcc: warning: linker setting ignored during compilation`
#     diagnostics.
#
# @private
# @param {string} EMCC - EMCC compiler (e.g., `emcc`)
# @param {string} CFLAGS - C compiler options
# @param {string} CXXFLAGS - C++ compiler options
# @param {string} INCLUDE - list of includes (e.g., `-I /foo/bar`)
# @param {string} LIBPATH - list of library paths (e.g., `-L /foo/bar`)
# @param {string} LIBRARIES - list of libraries (e.g., `-lopenblas`)
#/
$(wasm_targets): $(ALL_OBJS)
	@mkdir -p $(OBJ_DIR)
	$(QUIET) echo "  EMCC    (link) $@"
	$(QUIET) $(EMCC) $(CFLAGS) $(CXXFLAGS) $(EMCC_COMMON_FLAGS) $(EMCC_LINK_FLAGS) $(EMCC_HIGHWAY_FLAGS) $(INCLUDE) -o $@ $(ALL_OBJS) $(LIBPATH) $(LIBRARIES)

# Generate per-source C and C++ compile rules. The synthetic object names
# (`objs/c0.o`, `objs/cxx0.o`, ...) avoid collisions when sources share a
# basename (e.g. two unrelated `main.c` files in transitive dependencies).
define COMPILE_C_RULE
$(1): $(2)
	@mkdir -p $(OBJ_DIR)
	$(QUIET) echo "  EMCC    $(2)"
	$(QUIET) $(EMCC) $(CFLAGS) $(EMCC_COMMON_FLAGS) $(EMCC_COMPILE_FLAGS) $(EMCC_HIGHWAY_FLAGS) $(INCLUDE) -c $(2) -o $(1)
endef

define COMPILE_CXX_RULE
$(1): $(2)
	@mkdir -p $(OBJ_DIR)
	$(QUIET) echo "  EMCC    $(2)"
	$(QUIET) $(EMCC) $(CXXFLAGS) $(EMCC_COMMON_FLAGS) $(EMCC_COMPILE_FLAGS) $(EMCC_HIGHWAY_FLAGS) $(INCLUDE) -c $(2) -o $(1)
endef

# Pair each C source with its object file:
C_PAIRS := $(join $(C_OBJS),$(addprefix :,$(C_SOURCES)))
# Pair each C++ source with its object file:
CXX_PAIRS := $(join $(CXX_OBJS),$(addprefix :,$(CXX_SOURCES)))

$(foreach pair,$(C_PAIRS),$(eval $(call COMPILE_C_RULE,$(word 1,$(subst :, ,$(pair))),$(word 2,$(subst :, ,$(pair))))))
$(foreach pair,$(CXX_PAIRS),$(eval $(call COMPILE_CXX_RULE,$(word 1,$(subst :, ,$(pair))),$(word 2,$(subst :, ,$(pair))))))

#/
# Compiles WebAssembly binary files to the WebAssembly text format.
#
# @private
# @param {string} WASM2WAT - WAT compiler (e.g., `wasm2wat`)
#/
$(wat_targets): %.wat: %.wasm
	$(QUIET) $(WASM_TO_WAT) -o $@ $(wasm_targets)

#/
# Compiles WebAssembly binary files to JavaScript.
#
# @private
# @param {string} WASM2JS - JavaScript compiler (e.g., `wasm2js`)
#/
$(wasm_js_targets): %.wasm.js: %.wasm
	$(QUIET) $(WASM_TO_JS) -o $@ $(wasm_targets)

#/
# Generates an inline WebAssembly build for use in bundlers.
#
# @private
# @param {string} NODE - Node.js executable
#/
$(browser_js_targets): $(wasm_targets)
	$(QUIET) $(NODEJS) ./../scripts/build.js

#/
# Removes generated WebAssembly files.
#
# @example
# make clean-wasm
#/
clean-wasm:
	$(QUIET) -rm -f *.wasm *.wat *.wasm.js $(browser_js_targets)
	$(QUIET) -rm -rf $(OBJ_DIR)

.PHONY: clean-wasm

#/
# Removes generated files.
#
# @example
# make clean
#/
clean: clean-wasm

.PHONY: clean
