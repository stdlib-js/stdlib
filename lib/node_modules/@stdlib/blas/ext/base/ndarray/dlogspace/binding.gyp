# A `.gyp` file for building a Node.js native add-on.
#
# [1]: https://gyp.gsrc.io/docs/InputFormatReference.md
# [2]: https://gyp.gsrc.io/docs/UserDocumentation.md
{
  # List of files to include in this file:
  'includes': [
    './include.gypi',
  ],

  # Define variables to be used throughout the configuration for all targets:
  'variables': {
    # Target name should match the add-on export name:
    'addon_target_name%': 'addon',

    # Set variables based on the host OS:
    'conditions': [
      [
        'OS=="win"',
        {
          # Define the object file suffix:
          'obj': 'obj',
        },
        {
          # Define the object file suffix:
          'obj': 'o',
        }
      ],
    ], # end conditions
  }, # end variables

  # Define targets:
  'targets': [
    {
      # The target name should match the add-on export name:
      'target_name': '<(addon_target_name)',

      # Define dependencies:
      'dependencies': [],

      # List of source files:
      'sources': [
        '<@(src_files)',
      ],

      # Include directories:
      'include_dirs': [
        '<@(include_dirs)',
      ],

      # List of conditions:
      'conditions': [
        [
          'OS=="win"',
          {
            # Define library directories:
            'link_dirs': [
              '<@(library_dirs)',
            ],

            # Define libraries:
            'libraries': [
              '<@(libraries)',
            ],
          },
          # Note: intentionally empty object to avoid GyP syntax error:
          {}
        ],
        [
          'OS=="mac"',
          {
            # Linker flags:
            'xcode_settings': {
              'OTHER_LDFLAGS': [
                '-Wl,-search_paths_first',
                '<@(library_dirs)',
                '<@(libraries)',
              ],
            },
          },
          # Note: intentionally empty object to avoid GyP syntax error:
          {}
        ],
        [
          'OS!="win" and OS!="mac"',
          {
            # Linker flags:
            'ldflags': [
              '-Wl,-rpath,\'$$ORIGIN\'',
              '<@(library_dirs)',
              '<@(libraries)',
            ],
          },
          # Note: intentionally empty object to avoid GyP syntax error:
          {}
        ],
      ], # end conditions
    }, # end target <(addon_target_name)

    # Target to copy the built add-on binary to the destination directory:
    {
      'target_name': 'action_after_build',
      'type': 'none',
      'dependencies': [
        '<(addon_target_name)',
      ],
      'copies': [
        {
          'files': [
            '<(PRODUCT_DIR)/<(addon_target_name).node'
          ],
          'destination': '<(addon_output_dir)',
        },
      ],
    }, # end target action_after_build
  ], # end targets
}
