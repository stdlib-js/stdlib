{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "$id": "https://stdlib.io/schemas/semantic-document/v1.0.0.json",
  "title": "Semantic Document",
  "type": "object",
  "required": [
    "schemaVersion",
    "profile",
    "source",
    "titleRef",
    "summaryRef",
    "children",
    "resources",
    "accounting",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "profile": {
      "type": "object",
      "required": [ "name", "version" ],
      "properties": {
        "name": {
          "enum": [ "generic", "readme", "tutorial" ]
        },
        "version": {
          "const": "1.0.0"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "$ref": "#/definitions/documentSource"
    },
    "titleRef": {
      "$ref": "#/definitions/nullableId"
    },
    "summaryRef": {
      "$ref": "#/definitions/nullableId"
    },
    "children": {
      "$ref": "#/definitions/children"
    },
    "resources": {
      "$ref": "#/definitions/resources"
    },
    "accounting": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/accountingRecord"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/diagnostic"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "nullableId": {
      "oneOf": [
        {
          "$ref": "#/definitions/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableString": {
      "type": [ "string", "null" ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "documentSource": {
      "type": "object",
      "required": [ "mediaType", "digest", "encoding", "bom", "lineEnding" ],
      "properties": {
        "mediaType": {
          "const": "text/markdown"
        },
        "digest": {
          "$ref": "#/definitions/hash"
        },
        "encoding": {
          "const": "utf-8"
        },
        "bom": {
          "type": "boolean"
        },
        "lineEnding": {
          "enum": [ "lf", "crlf", "mixed", "none" ]
        }
      },
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "required": [ "line", "column", "offset" ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "required": [ "start", "end" ],
      "properties": {
        "start": {
          "$ref": "#/definitions/point"
        },
        "end": {
          "$ref": "#/definitions/point"
        }
      },
      "additionalProperties": false
    },
    "sourceRef": {
      "type": "object",
      "required": [
        "astPath",
        "origin",
        "transformation",
        "sourceHash"
      ],
      "properties": {
        "astPath": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "origin": {
          "enum": [ "source", "transformed" ]
        },
        "transformation": {
          "$ref": "#/definitions/nullableString"
        },
        "sourceHash": {
          "$ref": "#/definitions/hash"
        },
        "range": {
          "$ref": "#/definitions/range"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "semanticSource": {
      "type": "object",
      "required": [ "refs" ],
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sourceRef"
          }
        },
        "envelope": {
          "$ref": "#/definitions/range"
        }
      },
      "additionalProperties": false
    },
    "ast": {
      "type": "object",
      "required": [ "type" ],
      "properties": {
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "execution": {
      "type": "object",
      "required": [ "intent", "disabled", "expected", "reason" ],
      "properties": {
        "intent": {
          "enum": [ "candidate", "not-requested", "unknown" ]
        },
        "disabled": {
          "type": "boolean"
        },
        "expected": {
          "enum": [ "success", "throws" ]
        },
        "reason": {
          "$ref": "#/definitions/nullableString"
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": [
        "type",
        "id",
        "semanticKey",
        "role",
        "path",
        "ordinal",
        "headingRef",
        "children",
        "empty",
        "recovered",
        "source",
        "treeHash"
      ],
      "properties": {
        "type": {
          "const": "section"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "semanticKey": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "path": {
          "$ref": "#/definitions/stringArray"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "headingRef": {
          "$ref": "#/definitions/nullableId"
        },
        "children": {
          "$ref": "#/definitions/children"
        },
        "empty": {
          "type": "boolean"
        },
        "recovered": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/definitions/semanticSource"
        },
        "treeHash": {
          "$ref": "#/definitions/hash"
        }
      },
      "additionalProperties": false
    },
    "topic": {
      "type": "object",
      "required": [
        "type",
        "id",
        "semanticKey",
        "role",
        "headingRef",
        "children",
        "source",
        "treeHash"
      ],
      "properties": {
        "type": {
          "const": "topic"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "semanticKey": {
          "type": "string"
        },
        "role": {
          "enum": [ "api-entry-candidate", "generic", "tutorial-section", "tutorial-step" ]
        },
        "headingRef": {
          "$ref": "#/definitions/id"
        },
        "children": {
          "$ref": "#/definitions/children"
        },
        "source": {
          "$ref": "#/definitions/semanticSource"
        },
        "treeHash": {
          "$ref": "#/definitions/hash"
        }
      },
      "additionalProperties": false
    },
    "heading": {
      "type": "object",
      "required": [
        "type",
        "id",
        "depth",
        "text",
        "ast",
        "source",
        "payloadHash",
        "semanticHash"
      ],
      "properties": {
        "type": {
          "const": "heading"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "text": {
          "type": "string"
        },
        "ast": {
          "$ref": "#/definitions/ast"
        },
        "source": {
          "$ref": "#/definitions/semanticSource"
        },
        "payloadHash": {
          "$ref": "#/definitions/hash"
        },
        "semanticHash": {
          "$ref": "#/definitions/hash"
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "type",
        "id",
        "text",
        "ast",
        "source",
        "payloadHash",
        "semanticHash"
      ],
      "properties": {
        "type": {
          "const": "summary"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "text": {
          "type": "string"
        },
        "ast": {
          "$ref": "#/definitions/ast"
        },
        "source": {
          "$ref": "#/definitions/semanticSource"
        },
        "payloadHash": {
          "$ref": "#/definitions/hash"
        },
        "semanticHash": {
          "$ref": "#/definitions/hash"
        }
      },
      "additionalProperties": false
    },
    "markdown": {
      "type": "object",
      "required": [
        "type",
        "id",
        "role",
        "ast",
        "plainText",
        "source",
        "payloadHash",
        "semanticHash"
      ],
      "properties": {
        "type": {
          "const": "markdown"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "role": {
          "const": "prose"
        },
        "ast": {
          "$ref": "#/definitions/ast"
        },
        "plainText": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/semanticSource"
        },
        "payloadHash": {
          "$ref": "#/definitions/hash"
        },
        "semanticHash": {
          "$ref": "#/definitions/hash"
        }
      },
      "additionalProperties": false
    },
    "code": {
      "type": "object",
      "required": [
        "type",
        "id",
        "semanticKey",
        "language",
        "lang",
        "meta",
        "sourceStyle",
        "value",
        "role",
        "execution",
        "directiveRefs",
        "source",
        "sourceHash",
        "payloadHash",
        "semanticHash"
      ],
      "properties": {
        "type": {
          "const": "code"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "semanticKey": {
          "type": "string"
        },
        "language": {
          "$ref": "#/definitions/nullableString"
        },
        "lang": {
          "$ref": "#/definitions/nullableString"
        },
        "meta": {
          "$ref": "#/definitions/nullableString"
        },
        "sourceStyle": {
          "enum": [ "fenced", "indented" ]
        },
        "value": {
          "type": "string"
        },
        "role": {
          "enum": [
            "unknown",
            "setup",
            "usage-example",
            "example",
            "signature",
            "snippet",
            "shell-session"
          ]
        },
        "execution": {
          "$ref": "#/definitions/execution"
        },
        "directiveRefs": {
          "$ref": "#/definitions/stringArray"
        },
        "source": {
          "$ref": "#/definitions/semanticSource"
        },
        "sourceHash": {
          "$ref": "#/definitions/hash"
        },
        "payloadHash": {
          "$ref": "#/definitions/hash"
        },
        "semanticHash": {
          "$ref": "#/definitions/hash"
        }
      },
      "additionalProperties": false
    },
    "math": {
      "type": "object",
      "required": [
        "type",
        "id",
        "format",
        "display",
        "value",
        "label",
        "alt",
        "source",
        "sourceHash",
        "payloadHash",
        "semanticHash"
      ],
      "properties": {
        "type": {
          "const": "math"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "format": {
          "const": "tex"
        },
        "display": {
          "const": true
        },
        "value": {
          "type": "string"
        },
        "label": {
          "$ref": "#/definitions/nullableString"
        },
        "alt": {
          "$ref": "#/definitions/nullableString"
        },
        "source": {
          "$ref": "#/definitions/semanticSource"
        },
        "sourceHash": {
          "$ref": "#/definitions/hash"
        },
        "payloadHash": {
          "$ref": "#/definitions/hash"
        },
        "semanticHash": {
          "$ref": "#/definitions/hash"
        }
      },
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "required": [
        "type",
        "id",
        "mediaType",
        "authoredUrl",
        "renderedUrl",
        "alt",
        "alignment",
        "label",
        "definitionRef",
        "source",
        "sourceHash",
        "payloadHash",
        "semanticHash"
      ],
      "properties": {
        "type": {
          "const": "media"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "mediaType": {
          "const": "image"
        },
        "authoredUrl": {
          "$ref": "#/definitions/nullableString"
        },
        "renderedUrl": {
          "$ref": "#/definitions/nullableString"
        },
        "alt": {
          "type": "string"
        },
        "alignment": {
          "$ref": "#/definitions/nullableString"
        },
        "label": {
          "$ref": "#/definitions/nullableString"
        },
        "definitionRef": {
          "$ref": "#/definitions/nullableId"
        },
        "source": {
          "$ref": "#/definitions/semanticSource"
        },
        "sourceHash": {
          "$ref": "#/definitions/hash"
        },
        "payloadHash": {
          "$ref": "#/definitions/hash"
        },
        "semanticHash": {
          "$ref": "#/definitions/hash"
        }
      },
      "additionalProperties": false
    },
    "frontmatter": {
      "type": "object",
      "required": [
        "type",
        "id",
        "format",
        "value",
        "source",
        "sourceHash",
        "payloadHash",
        "semanticHash"
      ],
      "properties": {
        "type": {
          "const": "frontmatter"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "format": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/semanticSource"
        },
        "sourceHash": {
          "$ref": "#/definitions/hash"
        },
        "payloadHash": {
          "$ref": "#/definitions/hash"
        },
        "semanticHash": {
          "$ref": "#/definitions/hash"
        }
      },
      "additionalProperties": false
    },
    "raw": {
      "type": "object",
      "required": [
        "type",
        "id",
        "format",
        "value",
        "classification",
        "source",
        "sourceHash",
        "payloadHash",
        "semanticHash"
      ],
      "properties": {
        "type": {
          "const": "raw"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "format": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "classification": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/semanticSource"
        },
        "sourceHash": {
          "$ref": "#/definitions/hash"
        },
        "payloadHash": {
          "$ref": "#/definitions/hash"
        },
        "semanticHash": {
          "$ref": "#/definitions/hash"
        }
      },
      "additionalProperties": false
    },
    "thematicBreak": {
      "type": "object",
      "required": [
        "type",
        "id",
        "source",
        "payloadHash",
        "semanticHash"
      ],
      "properties": {
        "type": {
          "const": "thematicBreak"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "source": {
          "$ref": "#/definitions/semanticSource"
        },
        "payloadHash": {
          "$ref": "#/definitions/hash"
        },
        "semanticHash": {
          "$ref": "#/definitions/hash"
        }
      },
      "additionalProperties": false
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/definitions/section"
        },
        {
          "$ref": "#/definitions/topic"
        },
        {
          "$ref": "#/definitions/heading"
        },
        {
          "$ref": "#/definitions/summary"
        },
        {
          "$ref": "#/definitions/markdown"
        },
        {
          "$ref": "#/definitions/code"
        },
        {
          "$ref": "#/definitions/math"
        },
        {
          "$ref": "#/definitions/media"
        },
        {
          "$ref": "#/definitions/frontmatter"
        },
        {
          "$ref": "#/definitions/raw"
        },
        {
          "$ref": "#/definitions/thematicBreak"
        }
      ]
    },
    "definitionResource": {
      "type": "object",
      "required": [
        "id",
        "identifier",
        "normalizedIdentifier",
        "ordinal",
        "url",
        "title",
        "selected",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "identifier": {
          "type": "string"
        },
        "normalizedIdentifier": {
          "type": "string"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string"
        },
        "title": {
          "$ref": "#/definitions/nullableString"
        },
        "selected": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/definitions/semanticSource"
        }
      },
      "additionalProperties": false
    },
    "directiveResource": {
      "type": "object",
      "required": [
        "id",
        "family",
        "raw",
        "parsed",
        "scope",
        "targetRefs",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "family": {
          "enum": [ "eslint", "run", "run-disable" ]
        },
        "raw": {
          "type": "string"
        },
        "parsed": {
          "type": [ "object", "null" ]
        },
        "scope": {
          "enum": [ "next-code" ]
        },
        "targetRefs": {
          "$ref": "#/definitions/stringArray"
        },
        "source": {
          "$ref": "#/definitions/semanticSource"
        }
      },
      "additionalProperties": false
    },
    "embeddedCodeResource": {
      "type": "object",
      "required": [
        "id",
        "language",
        "lang",
        "meta",
        "value",
        "role",
        "execution",
        "directiveRefs",
        "source",
        "sourceHash",
        "payloadHash"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "language": {
          "$ref": "#/definitions/nullableString"
        },
        "lang": {
          "$ref": "#/definitions/nullableString"
        },
        "meta": {
          "$ref": "#/definitions/nullableString"
        },
        "value": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "execution": {
          "$ref": "#/definitions/execution"
        },
        "directiveRefs": {
          "$ref": "#/definitions/stringArray"
        },
        "source": {
          "$ref": "#/definitions/semanticSource"
        },
        "sourceHash": {
          "$ref": "#/definitions/hash"
        },
        "payloadHash": {
          "$ref": "#/definitions/hash"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": [ "definitions", "definitionIndex", "directives", "embeddedCode" ],
      "properties": {
        "definitions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/definitionResource"
          }
        },
        "definitionIndex": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/id"
          }
        },
        "directives": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/directiveResource"
          }
        },
        "embeddedCode": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/embeddedCodeResource"
          }
        }
      },
      "additionalProperties": false
    },
    "accountingRecord": {
      "type": "object",
      "required": [
        "astPath",
        "disposition",
        "nodeType",
        "classification",
        "reason",
        "source",
        "targetRefs",
        "sourceHash"
      ],
      "properties": {
        "astPath": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "disposition": {
          "enum": [
            "consumed-as-metadata",
            "consumed-as-structure",
            "discarded-maintenance",
            "moved-to-resource",
            "represented-in-flow",
            "transformed"
          ]
        },
        "nodeType": {
          "type": "string"
        },
        "classification": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/semanticSource"
        },
        "targetRefs": {
          "$ref": "#/definitions/stringArray"
        },
        "sourceHash": {
          "$ref": "#/definitions/hash"
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": [ "severity", "code", "message", "source", "details" ],
      "properties": {
        "severity": {
          "enum": [ "info", "warning", "error" ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/semanticSource"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
