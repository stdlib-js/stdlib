# Variables:
OUTDIR?=./src
CC?=gcc
CFLAGS+=-std=c99 -Wall -O3 -fPIC

# Include directories:
INCLUDES+=-I./include

# Source files:
SRC=$(wildcard src/*.c)

# Object files:
OBJ=$(SRC:.c=.o)

# Target library:
LIB=$(OUTDIR)/libhypergeometric_quantile.a

# Default target:
all: $(LIB)

# Create library:
$(LIB): $(OBJ)
	@mkdir -p $(OUTDIR)
	ar rcs $@ $^

# Compile source files:
%.o: %.c
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# Clean build artifacts:
clean:
	rm -f $(OBJ) $(LIB)

.PHONY: all clean
