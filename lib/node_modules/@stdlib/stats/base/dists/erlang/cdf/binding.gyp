{
  "variables": {
    "addon_name": "addon"
  },
  "targets": [
    {
      "target_name": "<(addon_name)",
      "type": "loadable_module",
      "dependencies": [
        "<(module_root_dir)/../../../../math/base/napi/ternary/binding.gyp:math_base_napi_ternary",
        "<(module_root_dir)/../../gamma/cdf/binding.gyp:stats_base_dists_gamma_cdf"
      ],
      "include_dirs": [
        "<(node_root_dir)/include/node",
        "<(module_root_dir)/include"
      ],
      "sources": [
        "src/addon.c",
        "src/main.c"
      ],
      "cflags_c": [
        "-std=c99",
        "-O3",
        "-Wall",
        "-pedantic"
      ],
      "conditions": [
        [
          "OS==\"mac\"",
          {
            "xcode_settings": {
              "GCC_C_LANGUAGE_STANDARD": "c99",
              "OTHER_CFLAGS": [
                "-O3",
                "-Wall",
                "-pedantic"
              ]
            }
          }
        ]
      ]
    }
  ]
}
