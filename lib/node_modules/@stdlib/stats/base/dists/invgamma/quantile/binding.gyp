{
  # Define variables to be used throughout the configuration for all targets:
  'variables': {
    # Set the package name:
    'pkg_name': '<!(node -e "console.log(require(\'./package.json\').name)")',

    # Define variables for dependencies:
    'deps': [
      '<!(node -e "require(\'@stdlib/math/base/special/gammaincinv/include-dir\')")',
      '<!(node -e "require(\'@stdlib/math/base/assert/is-nan/include-dir\')")'
    ],

    # Set variables for determining the host OS:
    'OS': '<!(node -e "console.log(process.platform)")',
  },

  # Define include directories for all targets:
  'includes': [
    './include.gypi'
  ],

  # Define targets:
  'targets': [
    {
      # Target name:
      'target_name': 'addon',

      # Source files:
      'sources': [
        './src/addon.c',
        './src/main.c'
      ],

      # Include directories:
      'include_dirs': [
        '<!(node -e "require(\'@stdlib/napi/export/include-dir\')")'
      ],

      # Define macros:
      'defines': [
        'NAPI_VERSION=<(napi_build_version)'
      ],

      # Define C flags:
      'cflags': [
        '-std=c99',
        '-O3',
        '-Wall',
        '-pedantic'
      ],

      # Define dependencies:
      'dependencies': [],

      # Conditions:
      'conditions': [
        [
          'OS=="win"',
          {
            'defines': [
              'STDLIB_NAPI_MODULE_EXPORT_FCN_WITH_MACROS_NAPI_VERSION=<(napi_build_version)'
            ]
          }
        ],
        [
          'OS=="mac"',
          {
            'xcode_settings': {
              'GCC_C_LANGUAGE_STANDARD': 'c99',
              'GCC_OPTIMIZATION_LEVEL': '3',
              'GCC_WARN_UNINITIALIZED_AUTOS': 'YES',
              'GCC_WARN_UNUSED_VARIABLE': 'YES',
              'GCC_WARN_UNUSED_FUNCTION': 'YES',
              'GCC_WARN_MISSING_PROTOTYPES': 'YES',
              'GCC_WARN_SHADOW': 'YES',
              'GCC_WARN_SIGN_COMPARE': 'YES',
              'GCC_WARN_ABOUT_RETURN_TYPE': 'YES',
              'GCC_WARN_UNUSED_PARAMETER': 'YES',
              'GCC_WARN_UNINITIALIZED_AUTOS': 'YES',
              'WARNING_CFLAGS': [
                '-Wall',
                '-pedantic'
              ]
            }
          }
        ]
      ]
    }
  ]
}
